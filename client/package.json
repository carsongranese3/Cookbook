{
  "name": "cookbook-client",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/build.mjs",
    "build:watch": "vite build --watch",
    "preview": "vite preview",
    "service:stop": "launchctl unload ~/Library/LaunchAgents/com.cookbook.build.plist",
    "service:start": "launchctl load ~/Library/LaunchAgents/com.cookbook.build.plist",
    "service:restart": "launchctl kickstart -k gui/$(id -u)/com.cookbook.build",
    "service:log": "tail -f build.log"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.1",
    "vite-plugin-pwa": "^1.3.0",
    "workbox-window": "^7.4.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "vite": "^5.4.11"
  }
}

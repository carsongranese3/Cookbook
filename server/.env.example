# Copy to .env and fill in. .env is gitignored — never commit real keys.

# Port the API listens on
PORT=3001

# Google Gemini API key for video→recipe extraction, receipt scanning, and price estimates.
# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional: override the primary Gemini model (default is gemini-3.1-flash-lite).
# On a 429/503 the server falls back through other free-tier Flash models.
# Leave blank to use the default.
GEMINI_MODEL=

# Optional: replace the whole model fallback chain (comma-separated model IDs).
GEMINI_MODELS=

# Optional: per-call Gemini timeout in milliseconds (default 120000).
GEMINI_TIMEOUT_MS=

# Optional: path to a Netscape-format cookies file for yt-dlp Instagram downloads.
# Instagram Reels usually require cookies; TikTok usually does not.
# The export must include the HttpOnly `sessionid` cookie.
# Example: /home/user/.config/yt-dlp/instagram-cookies.txt
YTDLP_COOKIES=

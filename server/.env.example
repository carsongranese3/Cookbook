# Copy to .env and fill in. .env is gitignored — never commit real keys.

# Port the API listens on
PORT=3001

# Google Gemini API key for video→recipe extraction.
# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional: override the Gemini model (default is gemini-2.0-flash).
# Leave blank to use the default.
GEMINI_MODEL=

# Optional: path to a Netscape-format cookies file for yt-dlp Instagram downloads.
# Instagram Reels often require cookies; TikTok usually does not.
# Example: /home/user/.config/yt-dlp/instagram-cookies.txt
YTDLP_COOKIES=

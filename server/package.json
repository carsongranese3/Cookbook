{
  "name": "cookbook-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Cookbook API — Express + SQLite",
  "scripts": {
    "dev": "node --watch index.js",
    "start": "node index.js",
    "service:stop": "launchctl unload ~/Library/LaunchAgents/com.cookbook.server.plist",
    "service:start": "launchctl load ~/Library/LaunchAgents/com.cookbook.server.plist",
    "service:restart": "launchctl kickstart -k gui/$(id -u)/com.cookbook.server",
    "service:log": "tail -f cookbook.log"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "better-sqlite3": "^11.8.1",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "multer": "^2.2.0"
  }
}
